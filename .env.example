# faster-whisper model name or local model path used for transcription.
WHISPER_MODEL=small

# CPU-friendly faster-whisper quantization mode.
WHISPER_COMPUTE_TYPE=int8

# Beam size used by faster-whisper transcription.
WHISPER_BEAM_SIZE=5

# Target maximum words per transcript-only retrieval chunk.
TRANSCRIPT_CHUNK_WORDS=70

# Compute device used by Faster-Whisper.
DEVICE=cpu

# Optional transcript cache directory. Empty uses the platform user cache.
VIDEOMIND_CACHE_DIR=
